# Copy to tofu.tfvars and fill in, or export as TF_VAR_* environment variables.
# scripts/00-auth.sh exports project_id and subnet_id automatically.

# project_id = "project-..."
# subnet_id  = "vpcsubnet-..."

# SSH public key for VM access (required):
#   export TF_VAR_ssh_public_key="$(cat ~/.ssh/id_rsa.pub)"
# ssh_public_key = "ssh-ed25519 AAAA..."

# Optional overrides:
# vm_preset         = "16vcpu-64gb"   # minimum for smoke test
# boot_disk_size_gb = 50
